# Copy to .env and fill in every value. .env is ignored by git.

# Password of the kanabol database user.
POSTGRES_PASSWORD=

# Key that signs the JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Hash of the Seq admin password, not the password itself. Generate it with:
# echo '<password>' | docker run --rm -i datalust/seq config hash
SEQ_ADMIN_HASH=

# Password of the initial admin user, who must change it at first login. At least 10 characters.
ADMIN_INITIAL_PASSWORD=

# Optional, in production only: the tag of the kanabol-api and kanabol-web images. v0.1.0 unless set.
# KANABOL_VERSION=
