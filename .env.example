# Copy to .env and fill in every value. .env is ignored by git.

# Password of the kanabol database user.
POSTGRES_PASSWORD=

# Key that signs the JWTs. Generate one with: openssl rand -base64 48
JWT_SECRET=

# Hash of the Seq admin password, not the password itself. Generate it with:
# echo '<password>' | docker run --rm -i datalust/seq config hash
SEQ_ADMIN_HASH=

# Password of the initial admin user, who must change it at first login. At least 10 characters.
ADMIN_INITIAL_PASSWORD=

# Optional: the vectorization for the search by meaning, off unless EMBEDDINGS_ENABLED=true (docs/SPEC.md §19.4).
# On, it needs the other four: the model the deployment runs (such as text-embedding-3-small), the Azure
# resource's https address, the name of the deployment and its key, from the Azure portal.
# EMBEDDINGS_ENABLED=
# EMBEDDINGS_MODEL=
# EMBEDDINGS_AZURE_ENDPOINT=
# EMBEDDINGS_AZURE_DEPLOYMENT=
# EMBEDDINGS_AZURE_API_KEY=

# Optional, in production only: the tag of the kanabol-api and kanabol-web images. Unless set, the
# default of compose.prod.yaml, the version of the commit (scripts/release.sh writes it).
# KANABOL_VERSION=
