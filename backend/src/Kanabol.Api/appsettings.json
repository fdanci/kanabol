{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq", "Serilog.Enrichers.Environment"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithEnvironmentName", "WithMachineName"],
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:5341" } }
    ]
  },
  "AllowedHosts": "*",
  "Alerts": {
    "OverdueCheckInterval": "00:15:00",
    "OverdueCheckEnabled": true
  },
  "Admin": {
    "Email": "admin@kanabol.local"
  },
  "Schedule": {
    "TimeZone": "Europe/Bucharest"
  },
  "Auth": {
    "RefreshTokenCleanupInterval": "1.00:00:00",
    "RefreshTokenCleanupEnabled": true
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "kanabol",
    "Audience": "kanabol",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "Root": "/data/attachments",
    "AllowedExtensions": "pdf,png,jpg,jpeg,gif,txt,md,csv,xlsx,docx,zip"
  }
}
